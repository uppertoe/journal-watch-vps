DOMAIN=myserver.example.com

# Proof-of-Caddy secret for Planka's gateway sign-in (apps/journal-watch).
# Caddy injects it as X-Gateway-Secret on planka.<domain>; Planka trusts
# Remote-Email / Remote-Groups only alongside it. 32 or more characters:
# `openssl rand -hex 32`. The same value goes in apps/journal-watch/.env as
# PLANKA_GATEWAY_SECRET, which jw_planka reads as GATEWAY_AUTH_SECRET.
#PLANKA_GATEWAY_SECRET=
