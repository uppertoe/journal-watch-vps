# App routing snippets from apps/*/*.caddy are rendered into the committed
# bundle .generated/caddy/apps.caddy by scaffold/docker/render-caddy-routes.sh
# and appended when the Caddy container starts. Adding an app: add its include
# to docker-compose.yml, re-render, commit .generated/.
#
# Global options below are folded into the scaffold's own global block by
# run-caddy.sh. Keep comments inside the block free of curly braces: that
# script counts them to find where the block ends.
{
	# Cloudflare proxies every public hostname here. Trusting its edge ranges
	# lets Caddy take the visitor's address from CF-Connecting-IP, so the
	# access log and the upstream X-Forwarded-For carry the real client
	# rather than a Cloudflare edge. Ranges from https://www.cloudflare.com/ips/
	# (checked 2026-10-28); keep them in step with jw_cloudflare_only in
	# apps/journal-watch/journalwatch.caddy.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}

	# Caddy's default order runs handle, handle_path and redir before abort,
	# so a site-level abort would never reach /static, /media or the www
	# redirect. Moving it ahead of redir makes the origin lock in
	# jw_cloudflare_only apply to every route.
	order abort before redir
}
